apiVersion: v1
kind: Secret
metadata:
  name: firefly-iii-credentials
  namespace: firefly-iii
type: Opaque
stringData:
  # APP_KEY and STATIC_CRON_TOKEN must each be exactly 32 characters.
  # Generate each independently with: openssl rand -hex 16
  APP_KEY: REPLACE_WITH_EXACTLY_32_RANDOM_CHARACTERS
  STATIC_CRON_TOKEN: REPLACE_WITH_A_DIFFERENT_32_CHARACTER_TOKEN
  DB_PASSWORD: REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
  postgres-password: REPLACE_WITH_A_DIFFERENT_RANDOM_POSTGRES_PASSWORD
  SITE_OWNER: REPLACE_WITH_YOUR_EMAIL_ADDRESS
