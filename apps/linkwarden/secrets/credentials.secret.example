apiVersion: v1
kind: Secret
metadata:
  name: linkwarden-credentials
  namespace: linkwarden
type: Opaque
stringData:
  # This must remain linkwarden: it is also configured in postgresql-values.yaml.
  db-password: REPLACE_WITH_A_LONG_UNIQUE_URL_SAFE_PASSWORD
  postgres-password: REPLACE_WITH_A_DIFFERENT_LONG_UNIQUE_URL_SAFE_PASSWORD
  nextauth-secret: REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
  meili-master-key: REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
