apiVersion: v1
kind: Secret
metadata:
  name: forgejo-postgresql-credentials
  namespace: forgejo
type: Opaque
stringData:
  # This must remain forgejo: it is also configured in postgresql-values.yaml.
  username: forgejo
  password: REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
  postgres-password: REPLACE_WITH_A_DIFFERENT_LONG_UNIQUE_PASSWORD
