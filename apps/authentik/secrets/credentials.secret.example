apiVersion: v1
kind: Secret
metadata:
  name: authentik-credentials
  namespace: authentik
type: Opaque
stringData:
  # Generate each value with: head -c 48 /dev/urandom | base64 | tr -d '\n'
  AUTHENTIK_SECRET_KEY: REPLACE_WITH_A_STABLE_RANDOM_VALUE
  AUTHENTIK_POSTGRESQL__PASSWORD: REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
  postgres-password: REPLACE_WITH_A_DIFFERENT_RANDOM_POSTGRES_PASSWORD
