apiVersion: v1
kind: Secret
metadata:
  name: mealie-postgresql-credentials
  namespace: mealie
type: Opaque
stringData:
  # This must remain mealie: it is also configured in postgresql-values.yaml.
  username: mealie
  password: REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
  postgres-password: REPLACE_WITH_A_DIFFERENT_LONG_UNIQUE_PASSWORD
