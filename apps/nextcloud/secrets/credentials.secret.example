apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-credentials
  namespace: nextcloud
type: Opaque
stringData:
  nextcloud-username: admin
  nextcloud-password: REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
  mariadb-password: REPLACE_WITH_A_DIFFERENT_LONG_UNIQUE_PASSWORD
  mariadb-root-password: REPLACE_WITH_A_THIRD_LONG_UNIQUE_PASSWORD
  mariadb-replication-password: REPLACE_WITH_A_FOURTH_LONG_UNIQUE_PASSWORD
  redis-password: REPLACE_WITH_A_FIFTH_LONG_UNIQUE_PASSWORD
